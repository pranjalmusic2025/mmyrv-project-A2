# Environment Variables - Copy this file to .env.local and fill in your values
# NEVER commit .env.local to Git

# Supabase Project URL (from Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Anon/Public Key (from Supabase Dashboard → Settings → API)
# This is the PUBLISHABLE key — safe to use in frontend
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App Configuration
VITE_APP_NAME="Student Attendance System"
VITE_APP_VERSION="1.0.0"

# QR Token settings (seconds)
VITE_QR_TOKEN_EXPIRY_SECONDS=30

# Optional: GPS Configuration (set in Admin Dashboard)
# VITE_DEFAULT_CAMPUS_LAT=28.6139
# VITE_DEFAULT_CAMPUS_LNG=77.2090
# VITE_DEFAULT_CAMPUS_RADIUS_METERS=200
